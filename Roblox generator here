    js = r'''let nonstopTimer=null;
let generatedTotal=0;
let checkingTotal=0;

function makeOne(){
  const len=Math.max(3,Math.min(20,Number($("length").value)||4));
  const useNumbers=$("numbers").value==="yes";
  const useUnderscore=$("underscore").value==="yes";
  const letters="abcdefghijklmnopqrstuvwxyz";
  const chars=letters+(useNumbers?"0123456789":"");
  let n="";
  for(let i=0;i<len;i++) n+=chars[Math.floor(Math.random()*chars.length)];
  if(useUnderscore && len>3){
    const pos=1+Math.floor(Math.random()*(len-1));
    n=n.slice(0,pos)+"_"+n.slice(pos);
    n=n.slice(0,len);
  }
  return n;
}

function addGeneratedOnly(){
  const n=makeOne();
  const box=$("results-generated");
  const empty=box.querySelector(".small");
  if(empty) empty.remove();
  const d=document.createElement("div");
  d.className="result";
  d.innerHTML=`<span class="name">${escapeHtml(n)}</span><span class="badge">GENERATED</span>`;
  box.prepend(d);
  generatedTotal++;
  $("generatedCount").textContent=generatedTotal;
  $("generatedStat").textContent=generatedTotal;
  const rows=box.querySelectorAll(".result");
  if(rows.length>1000) rows[rows.length-1].remove();
}

function startSniper(){
  if(nonstopTimer)return;
  nonstopTimer=setInterval(()=>{
    for(let i=0;i<5;i++) addGeneratedOnly();
