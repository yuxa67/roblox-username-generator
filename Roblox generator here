function stopSniper(){
  if(nonstopTimer){clearInterval(nonstopTimer);nonstopTimer=null;}
  $("startBtn").textContent="⚡ START • 5/SEC";
  $("stopBtn").classList.remove("running");
  $("continuousStatus").textContent="Stopped — press START to generate continuously.";
}

